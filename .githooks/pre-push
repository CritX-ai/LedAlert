#!/bin/sh
# Full release-source gate: documentation and the controlled Linux baseline.
# This does not publish. It intentionally requires a Linux x86_64 environment
# with the pinned-builder prerequisites; a Windows-only smoke is not a substitute.
set -e
cd "$(git rev-parse --show-toplevel)"

PYTHON=
for candidate in python3 python; do
    if "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1; then
        PYTHON=$candidate
        break
    fi
done
if [ -z "$PYTHON" ]; then
    echo "Python 3.11+ is required (python3 or python on PATH)." >&2
    exit 1
fi
if command -v podman >/dev/null 2>&1; then
    container=podman
elif command -v docker >/dev/null 2>&1; then
    container=docker
else
    echo "Full verification requires Podman or Docker plus Pandoc; no checks were skipped." >&2
    exit 1
fi

echo "==> Production documentation build (pinned ReGen container)"
"$PYTHON" packaging/docs.py --container "$container" --output dist/docs

echo "==> Source, artifact and Cargo package verification (pinned baseline)"
"$PYTHON" packaging/release.py --verify --crate --commit "$(git rev-parse HEAD)" --output "$(mktemp -d dist/release-verify.XXXXXX)"

echo "==> Release gate passed"
